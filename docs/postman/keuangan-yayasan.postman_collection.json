{
    "info": {
        "name": "Keuangan Yayasan - API v1",
        "description": "Pengujian endpoint baca-saja /api/v1/* (lihat docs/api-integrasi.md). Isi variabel `token` dengan token Klien API dari Keuangan > Klien API.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Sukses (token dengan ability sesuai)",
            "item": [
                {
                    "name": "GET pembayaran-spp",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/pembayaran-spp",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "pembayaran-spp"],
                            "query": [
                                {
                                    "key": "per_page",
                                    "value": "10"
                                }
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Format JSON dengan data', () => { const j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                                    "pm.test('Ada meta paginasi', () => pm.expect(pm.response.json()).to.have.property('meta'));"
                                ]
                            }
                        }
                    ]
                },
